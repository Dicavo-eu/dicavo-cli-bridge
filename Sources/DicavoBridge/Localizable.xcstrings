{
  "sourceLanguage": "en",
  "strings": {
    "The AI tool executable was not found at %@.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustitelný soubor AI nástroje nebyl nalezen v umístění %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausführbare Datei des KI-Tools wurde nicht unter %@ gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado el ejecutable de la herramienta de IA en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’exécutable de l’outil d’IA est introuvable à l’emplacement %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’eseguibile dello strumento IA non è stato trovato in %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono pliku wykonywalnego narzędzia AI w lokalizacji %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O executável da ferramenta de IA não foi encontrado em %@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustiteľný súbor AI nástroja sa nenašiel na ceste %@."
          }
        }
      }
    },
    "The selected AI tool is not executable: %@.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybraný AI nástroj není spustitelný: %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte KI-Tool ist nicht ausführbar: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La herramienta de IA seleccionada no es ejecutable: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’outil d’IA sélectionné n’est pas exécutable : %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo strumento IA selezionato non è eseguibile: %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można uruchomić wybranego narzędzia AI: %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A ferramenta de IA selecionada não é executável: %@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybraný AI nástroj nie je spustiteľný: %@."
          }
        }
      }
    },
    "%@ could not be started: %@": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se nepodařilo spustit: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht gestartet werden: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido iniciar %@: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas pu être démarré : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non può essere avviato: %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można uruchomić %1$@: %2$@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar %@: %@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sa nepodarilo spustiť: %2$@"
          }
        }
      }
    },
    "No diagnostic output.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez diagnostického výstupu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Diagnoseausgabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay salida de diagnóstico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune sortie de diagnostic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun output diagnostico."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak danych diagnostycznych."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem saída de diagnóstico."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez diagnostického výstupu."
          }
        }
      }
    },
    "%@ sign-in has expired or is invalid. Open Terminal and run:\n%@\nComplete sign-in, then retry AI analysis. Your recording and transcript are saved.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlášení do %1$@ vypršelo nebo je neplatné. Otevřete Terminál a spusťte:\n%2$@\nDokončete přihlášení a znovu spusťte AI analýzu. Nahrávka i přepis jsou uložené."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung bei %@ ist abgelaufen oder ungültig. Öffnen Sie Terminal und führen Sie Folgendes aus:\n%@\nSchließen Sie die Anmeldung ab und wiederholen Sie dann die KI-Analyse. Ihre Aufnahme und das Transkript sind gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sign-in has expired or is invalid. Open Terminal and run:\n%@\nComplete the sign-in, then retry AI analysis. Your recording and transcript are saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión de %@ ha caducado o no es válido. Abre Terminal y ejecuta:\n%@\nCompleta el inicio de sesión y vuelve a intentar el análisis de IA. Tu grabación y la transcripción están guardadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à %@ a expiré ou n’est pas valide. Ouvrez Terminal et exécutez :\n%@\nTerminez la connexion, puis relancez l’analyse IA. Votre enregistrement et sa transcription sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso a %1$@ è scaduto o non è valido. Apri Terminale ed esegui:\n%2$@\nCompleta l’accesso, poi riprova l’analisi IA. La registrazione e la trascrizione sono salvate."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie do %1$@ wygasło lub jest nieprawidłowe. Otwórz Terminal i uruchom:\n%2$@\nDokończ logowanie, a następnie ponów analizę AI. Nagranie i transkrypcja są zapisane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão em %@ expirou ou é inválida. Abra o Terminal e execute:\n%@\nConclua o início de sessão e tente novamente a análise de IA. A gravação e a transcrição estão guardadas."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnosť prihlásenia do %1$@ vypršala alebo je prihlásenie neplatné. Otvorte Terminál a spustite:\n%2$@\nDokončite prihlásenie a znova spustite AI analýzu. Nahrávka aj prepis sú uložené."
          }
        }
      }
    },
    "%@ analysis timed out.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Analýza přes %@ překročila časový limit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Analyse mit %@ hat das Zeitlimit überschritten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis con %@ ha agotado el tiempo de espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse avec %@ a dépassé le délai imparti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analisi con %@ ha superato il tempo massimo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza za pomocą %@ przekroczyła limit czasu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise com %@ excedeu o tempo limite."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Analýza cez %@ prekročila časový limit."
          }
        }
      }
    },
    "A transcript segment or partial analysis is too large to process safely.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Část přepisu nebo dílčí analýza je příliš velká pro bezpečné zpracování."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Transkriptabschnitt oder eine Teilanalyse ist zu groß, um sicher verarbeitet zu werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un segmento de la transcripción o un análisis parcial es demasiado grande para procesarlo de forma segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un segment de transcription ou une analyse partielle est trop volumineux pour être traité en toute sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un segmento della trascrizione o un’analisi parziale ha dimensioni eccessive per l’elaborazione in sicurezza."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragment transkrypcji lub częściowa analiza ma zbyt duży rozmiar, aby można było bezpiecznie kontynuować przetwarzanie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um segmento da transcrição ou uma análise parcial é demasiado grande para ser processado em segurança."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Časť prepisu alebo čiastková analýza je príliš veľká na bezpečné spracovanie."
          }
        }
      }
    },
    "The AI tool returned an empty analysis.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "AI nástroj vrátil prázdnou analýzu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das KI-Tool hat eine leere Analyse zurückgegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La herramienta de IA ha devuelto un análisis vacío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’outil d’IA a renvoyé une analyse vide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo strumento IA ha restituito un’analisi vuota."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narzędzie AI zwróciło pustą analizę."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A ferramenta de IA devolveu uma análise vazia."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "AI nástroj vrátil prázdnu analýzu."
          }
        }
      }
    },
