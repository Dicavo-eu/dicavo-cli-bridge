          "stringUnit": {
            "state": "translated",
            "value": "AI analýza obsahuje vyhradenú značku Dicava."
          }
        }
      }
    },
    "The structured AI analysis could not be decoded: %@": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Strukturovanou AI analýzu se nepodařilo dekódovat: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die strukturierte KI-Analyse konnte nicht decodiert werden: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido decodificar el análisis de IA estructurado: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse IA structurée n’a pas pu être décodée : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile decodificare l’analisi IA strutturata: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zdekodować ustrukturyzowanej analizy AI: %@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível descodificar a análise de IA estruturada: %@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Štruktúrovanú AI analýzu sa nepodarilo dekódovať: %@"
          }
        }
      }
    },
    "%@ sends the transcript to an external service. Confirm that in Settings → AI before analysis can run. Nothing was sent.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ posílá přepis externí službě. Potvrďte to v Nastavení → AI, aby bylo možné spustit analýzu. Nic se neodeslalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sendet das Transkript an einen externen Dienst. Bestätigen Sie das unter Einstellungen → KI, bevor die Analyse ausgeführt werden kann. Es wurde nichts gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sends the transcript to an external service. Confirm this in Settings → AI before analysis can run. Nothing was sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ envía la transcripción a un servicio externo. Confírmalo en Ajustes → IA antes de que pueda ejecutarse el análisis. No se ha enviado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ envoie la transcription à un service externe. Confirmez-le dans Réglages → IA avant de pouvoir lancer l’analyse. Rien n’a été envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ invia la trascrizione a un servizio esterno. Confermalo in Impostazioni → IA prima di avviare l’analisi. Non è stato inviato nulla."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wysyła transkrypcję do zewnętrznej usługi. Potwierdź to w Ustawieniach → AI, aby można było uruchomić analizę. Nic nie zostało wysłane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ envia a transcrição para um serviço externo. Confirme isso em Definições → IA para que a análise possa ser executada. Nada foi enviado."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ odosiela prepis externej službe. Pred spustením analýzy to potvrďte v časti Nastavenia → AI. Nič sa neodoslalo."
          }
        }
      }
    },
    "Dicavo Pro ended on %@. ": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicavo Pro skončilo dne %@. "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicavo Pro ist am %@ abgelaufen. "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicavo Pro finalizó el %@. "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicavo Pro a pris fin le %@. "
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicavo Pro è terminato il %@. "
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicavo Pro wygasło %@. "
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dicavo Pro terminou a %@. "
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnosť Dicavo Pro sa skončila dňa %@. "
          }
        }
      }
    },
    "Cloud AI analysis needs Dicavo Pro. Nothing was sent; your recording and transcript are saved.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Analýza přes cloudovou AI vyžaduje Dicavo Pro. Nic se neodeslalo; nahrávka i přepis jsou uložené."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cloud-KI-Analyse erfordert Dicavo Pro. Es wurde nichts gesendet; Ihre Aufnahme und das Transkript sind gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis de IA en la nube requiere Dicavo Pro. No se ha enviado nada; tu grabación y la transcripción están guardadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse IA dans le cloud nécessite Dicavo Pro. Rien n’a été envoyé ; votre enregistrement et sa transcription sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analisi IA nel cloud richiede Dicavo Pro. Non è stato inviato nulla; la registrazione e la trascrizione sono salvate."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza AI w chmurze wymaga Dicavo Pro. Nic nie zostało wysłane; nagranie i transkrypcja są zapisane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise de IA na nuvem requer o Dicavo Pro. Nada foi enviado; a gravação e a transcrição estão guardadas."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Analýza cez cloudovú AI vyžaduje Dicavo Pro. Nič sa neodoslalo; nahrávka aj prepis sú uložené."
          }
        }
      }
    },
    "Dicavo CLI Bridge analysis needs Dicavo Pro. Nothing was sent; your recording and transcript are saved.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Analýza přes Dicavo CLI Bridge vyžaduje Dicavo Pro. Nic se neodeslalo; nahrávka i přepis jsou uložené."
