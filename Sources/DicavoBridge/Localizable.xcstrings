    "You have %@. The bridge downloads the update from dicavo.eu, checks that it is signed by the Dicavo developer and notarized by Apple, replaces itself and starts again.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte verzi %@. Bridge stáhne aktualizaci z dicavo.eu, ověří, že ji podepsal vývojář Dicava a notarizoval Apple, nahradí aktuální verzi a znovu se spustí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie verwenden Version %@. Die Bridge lädt das Update von dicavo.eu, prüft, ob es vom Dicavo-Entwickler signiert und von Apple notarisiert ist, ersetzt sich selbst und startet neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have %@. The Bridge downloads the update from dicavo.eu, checks that it is signed by the Dicavo developer and notarized by Apple, replaces itself and starts again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes la versión %@. El Bridge descarga la actualización desde dicavo.eu, comprueba que esté firmada por el desarrollador de Dicavo y certificada por Apple, se reemplaza y se vuelve a iniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous utilisez la version %@. Le Bridge télécharge la mise à jour depuis dicavo.eu, vérifie qu’elle est signée par le développeur de Dicavo et notarisée par Apple, se remplace lui-même et redémarre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai la versione %@. Il Bridge scarica l’aggiornamento da dicavo.eu, verifica che sia firmato dallo sviluppatore di Dicavo e autenticato da Apple, si sostituisce e si riavvia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz wersję %@. Bridge pobierze uaktualnienie z dicavo.eu, sprawdzi, czy jest podpisane przez twórcę Dicavo i poddane notaryzacji przez Apple, zastąpi obecną wersję i uruchomi się ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem a versão %@. O Bridge descarrega a atualização de dicavo.eu, verifica se está assinada pelo programador do Dicavo e autenticada pela Apple, substitui-se e volta a iniciar."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte verziu %@. Bridge stiahne aktualizáciu z dicavo.eu, overí, že ju podpísal vývojár Dicava a notarizoval Apple, nahradí svoju aktuálnu verziu a znova sa spustí."
          }
        }
      }
    },
