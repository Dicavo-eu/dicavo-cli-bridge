    },
    "The running version is unchanged. You can also download the update from dicavo.eu.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Běžící verze zůstala beze změny. Aktualizaci si můžete stáhnout také z dicavo.eu."
          }
        },
        "de": {
