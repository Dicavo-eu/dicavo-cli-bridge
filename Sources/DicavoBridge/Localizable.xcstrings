    "Dicavo is waiting for an AI analysis with %@. If you quit the bridge, the analysis stops and has to be started again in Dicavo. The recording and transcript stay saved.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicavo čeká na AI analýzu přes %@. Pokud Bridge ukončíte, analýza se přeruší a v Dicavu ji bude potřeba spustit znovu. Nahrávka i přepis zůstanou uložené."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicavo wartet auf eine KI-Analyse mit %@. Wenn Sie die Bridge beenden, bricht die Analyse ab und muss in Dicavo erneut gestartet werden. Aufnahme und Transkript bleiben gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicavo is waiting for an AI analysis using %@. If you quit the Bridge, the analysis will stop and you will need to restart it in Dicavo. The recording and transcript stay saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicavo está esperando un análisis de IA con %@. Si sales del Bridge, el análisis se detendrá y tendrás que reiniciarlo en Dicavo. La grabación y la transcripción se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicavo attend une analyse IA avec %@. Si vous quittez le Bridge, l’analyse s’arrêtera et vous devrez la relancer dans Dicavo. L’enregistrement et la transcription restent enregistrés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicavo è in attesa di un’analisi IA con %@. Se esci dal Bridge, l’analisi si interrompe e dovrai riavviarla in Dicavo. La registrazione e la trascrizione restano salvate."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicavo czeka na analizę AI z użyciem %@. Jeśli zakończysz działanie Bridge, analiza zostanie przerwana i trzeba będzie uruchomić ją ponownie w Dicavo. Nagranie i transkrypcja pozostaną zapisane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dicavo está a aguardar uma análise de IA com %@. Se sair do Bridge, a análise será interrompida e terá de a reiniciar no Dicavo. A gravação e a transcrição permanecem guardadas."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicavo čaká na AI analýzu cez %@. Ak Bridge ukončíte, analýza sa preruší a v Dicave ju bude treba spustiť znova. Nahrávka aj prepis ostávajú uložené."
          }
        }
      }
    },
