    "Version %@ is installed. Quit and reopen Dicavo CLI Bridge to start it.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Verze %@ je nainstalovaná. Spustíte ji, když Dicavo CLI Bridge ukončíte a znovu otevřete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ ist installiert. Beenden Sie Dicavo CLI Bridge und öffnen Sie die App erneut, um die neue Version zu starten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja %@ jest zainstalowana. Aby ją uruchomić, zakończ i ponownie otwórz Dicavo CLI Bridge."
