    "One argument per line, passed exactly as written. There is no shell: quotes, variables and redirections have no special meaning.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden argument na řádek, předá se přesně tak, jak je napsaný. Příkaz běží bez shellu: uvozovky, proměnné ani přesměrování nemají zvláštní význam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Argument pro Zeile, das genau so übergeben wird, wie es geschrieben ist. Es gibt keine Shell: Anführungszeichen, Variablen und Umleitungen haben keine besondere Bedeutung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un argumento por línea, que se pasa tal como está escrito. No hay shell: las comillas, las variables y las redirecciones no tienen ningún significado especial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un argument par ligne, transmis exactement tel qu’il est écrit. Il n’y a pas de shell : les guillemets, les variables et les redirections n’ont aucune signification particulière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un argomento per riga, passato esattamente come scritto. Non c’è una shell: virgolette, variabili e reindirizzamenti non hanno alcun significato speciale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden argument na wiersz, przekazywany dokładnie tak, jak go wpisano. Polecenie działa bez powłoki: cudzysłowy, zmienne i przekierowania nie mają specjalnego znaczenia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um argumento por linha, passado exatamente como está escrito. Não há shell: aspas, variáveis e redirecionamentos não têm significado especial."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý argument napíšte na samostatný riadok. Odovzdá sa presne tak, ako je napísaný. Príkaz beží bez shellu: úvodzovky, premenné ani presmerovania nemajú osobitný význam."
          }
        }
      }
    },
