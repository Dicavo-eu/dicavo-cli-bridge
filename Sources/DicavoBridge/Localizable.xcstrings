    "AI analysis uses a locally installed command-line tool that this device cannot run. Transfer the recording to your Mac to analyze it there.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "AI analýza probíhá pomocí lokálně nainstalovaného nástroje příkazového řádku, který toto zařízení nedokáže spustit. Přeneste nahrávku do Macu a analyzujte ji tam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI-Analyse läuft über ein lokal installiertes Befehlszeilen-Tool, das dieses Gerät nicht ausführen kann. Übertragen Sie die Aufnahme auf Ihren Mac und analysieren Sie sie dort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis de IA usa una herramienta de línea de comandos instalada localmente que este dispositivo no puede ejecutar. Transfiere la grabación a tu Mac para analizarla allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse IA utilise un outil en ligne de commande installé localement que cet appareil ne peut pas exécuter. Transférez l’enregistrement sur votre Mac pour l’y analyser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analisi IA usa uno strumento da riga di comando installato localmente che questo dispositivo non può eseguire. Trasferisci la registrazione sul tuo Mac per analizzarla lì."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza AI korzysta z lokalnie zainstalowanego narzędzia wiersza poleceń, którego to urządzenie nie może uruchomić. Przenieś nagranie na Maca i przeanalizuj je tam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise de IA utiliza uma ferramenta de linha de comandos instalada localmente que este dispositivo não consegue executar. Transfira a gravação para o seu Mac para a analisar aí."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "AI analýza využíva lokálne nainštalovaný nástroj príkazového riadka, ktorý toto zariadenie nedokáže spustiť. Preneste nahrávku do Macu a analyzujte ju tam."
          }
        }
      }
    },
