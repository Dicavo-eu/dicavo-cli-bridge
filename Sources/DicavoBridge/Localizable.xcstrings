    "The running version is unchanged. You can also download the update from dicavo.eu.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Běžící verze zůstala beze změny. Aktualizaci si můžete stáhnout také z dicavo.eu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die laufende Version bleibt unverändert. Sie können das Update auch von dicavo.eu herunterladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión en ejecución no ha cambiado. También puedes descargar la actualización desde dicavo.eu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version en cours d’exécution reste inchangée. Vous pouvez aussi télécharger la mise à jour sur dicavo.eu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione in esecuzione resta invariata. Puoi anche scaricare l’aggiornamento da dicavo.eu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchomiona wersja pozostała bez zmian. Uaktualnienie możesz też pobrać z dicavo.eu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão em execução não foi alterada. Também pode descarregar a atualização em dicavo.eu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bežiaca verzia ostala bez zmeny. Aktualizáciu si môžete stiahnuť aj z dicavo.eu."
          }
        }
      }
    },
