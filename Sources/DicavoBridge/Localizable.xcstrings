    "One argument per line, passed exactly as written. There is no shell: quotes, variables and redirections have no special meaning.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden argument na řádek, předá se přesně tak, jak je napsaný. Příkaz běží bez shellu: uvozovky, proměnné ani přesměrování nemají zvláštní význam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Argument pro Zeile, das genau so übergeben wird, wie es geschrieben ist. Es gibt keine Shell: Anführungszeichen, Variablen und Umleitungen haben keine besondere Bedeutung."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden argument na wiersz, przekazywany dokładnie tak, jak go wpisano. Polecenie działa bez powłoki: cudzysłowy, zmienne i przekierowania nie mają specjalnego znaczenia."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý argument napíšte na samostatný riadok. Odovzdá sa presne tak, ako je napísaný. Príkaz beží bez shellu: úvodzovky, premenné ani presmerovania nemajú osobitný význam."
          }
        }
      }
    },
