    "%@ is over its usage limit right now. The recording, transcript and note are saved; retry the AI analysis later.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nástroj %@ právě dosáhl limitu využití. Nahrávka, přepis i zápis jsou uložené; AI analýzu zkuste znovu později."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
