    "The AI analysis contains a reserved Dicavo marker.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "AI analýza obsahuje vyhrazenou značku Dicavo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI-Analyse enthält eine reservierte Dicavo-Markierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis de IA contiene un marcador reservado de Dicavo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse IA contient un marqueur réservé de Dicavo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analisi IA contiene un contrassegno riservato di Dicavo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza AI zawiera zastrzeżony znacznik Dicavo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise de IA contém um marcador reservado do Dicavo."
          }
        },
