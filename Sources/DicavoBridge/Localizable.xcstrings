          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchomiona wersja pozostała bez zmian. Uaktualnienie możesz też pobrać z dicavo.eu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bežiaca verzia ostala bez zmeny. Aktualizáciu si môžete stiahnuť aj z dicavo.eu."
          }
        }
      }
    },
    "Runs the Claude Code, Codex or Antigravity installed on this Mac for Dicavo.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
