    "You have %@. The bridge downloads the update from dicavo.eu, checks that it is signed by the Dicavo developer and notarized by Apple, replaces itself and starts again.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte verzi %@. Bridge stáhne aktualizaci z dicavo.eu, ověří, že ji podepsal vývojář Dicavo a notarizoval Apple, nahradí aktuální verzi a znovu se spustí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie verwenden Version %@. Die Bridge lädt das Update von dicavo.eu, prüft, ob es vom Dicavo-Entwickler signiert und von Apple notarisiert ist, ersetzt sich selbst und startet neu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz wersję %@. Bridge pobierze uaktualnienie z dicavo.eu, sprawdzi, czy jest podpisane przez twórcę Dicavo i poddane notaryzacji przez Apple, zastąpi obecną wersję i uruchomi się ponownie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte verziu %@. Bridge stiahne aktualizáciu z dicavo.eu, overí, že ju podpísal vývojár Dicava a notarizoval Apple, nahradí svoju aktuálnu verziu a znova sa spustí."
          }
        }
      }
    },
